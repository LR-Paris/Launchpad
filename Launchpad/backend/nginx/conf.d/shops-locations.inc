# Shop: winter-gwp-26
location /winter-gwp-26/ {
    # CLOSED 2026-08-04. The shop's own password gate is client-side only: the
    # password ships in the page source and /api/ is unauthenticated, so an order
    # could be POSTed without ever unlocking. Closing at the edge instead, which
    # covers pages, API and checkout in one place.
    # Credentials: user 'lrparis', password 'lrparisclosed'.
    # To reopen: delete these three lines and `nginx -t && systemctl reload nginx`.
    auth_basic "LR Paris - this shop is closed";
    auth_basic_user_file /etc/nginx/.htpasswd-winter-gwp-26;

    proxy_pass http://127.0.0.1:8121;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
}

